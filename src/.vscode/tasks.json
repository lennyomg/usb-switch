{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Copy",
            "detail": "Copy python files to the board",
            "type": "shell",
            "command": "rsync -ruv *.py /Volumes/CIRCUITPY ",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Terminal",
            "detail": "Connect to the terminal",
            "type": "shell",
            "command": "screen /dev/tty.usbmodem* 115200",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Unmount",
            "detail": "Connect to the terminal",
            "type": "shell",
            "command": "osascript -e 'tell application \"Finder\" to eject (every disk whose ejectable is true)'",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}